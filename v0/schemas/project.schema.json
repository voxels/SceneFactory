{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scene-factory/schemas/project.schema.json",
  "title": "Scene Factory Project",
  "type": "object",
  "required": ["schema_version", "project", "models", "defaults", "characters", "environments", "hierarchy", "concept_registry"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "required": ["id", "title", "format"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "format": {
          "type": "object",
          "required": ["width", "height", "fps"],
          "properties": {
            "width": {"type": "integer", "minimum": 64},
            "height": {"type": "integer", "minimum": 64},
            "fps": {"type": "number", "exclusiveMinimum": 0},
            "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "models": {
      "type": "object",
      "required": ["prompt_planner", "image_generator", "video_generator"],
      "additionalProperties": {"type": ["string", "object"]}
    },
    "path_defaults": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "defaults": {
      "type": "object",
      "required": ["formations_per_shot", "video_frame_rule"],
      "properties": {
        "formations_per_shot": {"type": "integer", "minimum": 1},
        "video_frame_rule": {"enum": ["mod8_plus1", "none"]},
        "identity_review_required": {"type": "boolean"},
        "keyframe_review_required": {"type": "boolean"}
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "identity_tag", "source_folder", "attribute_tags"],
        "properties": {
          "id": {"type": "string"},
          "role": {"enum": ["foreground", "background"]},
          "identity_tag": {"type": "string"},
          "concept_id": {"type": ["string", "null"]},
          "source_folder": {"type": "string"},
          "attribute_tags": {"type": "array", "items": {"type": "string"}},
          "training": {"type": "object"},
          "continuity": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reference_folder", "attribute_tags"],
        "properties": {
          "id": {"type": "string"},
          "concept_id": {"type": ["string", "null"]},
          "reference_folder": {"type": "string"},
          "attribute_tags": {"type": "array", "items": {"type": "string"}},
          "continuity": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "motion_references": {"type": "array", "items": {"type": "object"}},
    "hierarchy": {
      "type": "object",
      "required": ["content_root", "script_sources"],
      "properties": {
        "content_root": {"type": "string"},
        "script_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["glob", "adapter"],
            "properties": {
              "glob": {"type": "string"},
              "adapter": {"enum": ["scene_factory_v1", "ad2184_v1"]}
            }
          }
        }
      }
    },
    "concept_registry": {"type": "string"}
  }
}
